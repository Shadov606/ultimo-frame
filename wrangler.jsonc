{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ultimo-frame",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ultimo-frame-db",
      "database_id": "INCOLLA_QUI_IL_DATABASE_ID"
    }
  ]
}